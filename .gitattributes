# Normalise line endings. The repo is authored on Windows but builds and runs on Linux (the
# container, CI), so text files are stored with LF and checked out natively.
* text=auto eol=lf

# Shell scripts and the container entrypoint must be LF or they will not run in the image.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell is happier with CRLF on Windows.
*.ps1 text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
pnpm-lock.yaml -diff
