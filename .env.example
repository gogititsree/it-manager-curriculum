# Copy to .env for local development. Never commit .env.

# --- required ---
# Bearer token the web and mobile clients send as `Authorization: Bearer <token>`.
# Generate a strong one:  node scripts/new-token.mjs "laptop"
# The API refuses to start in production (NODE_ENV=production) if this is missing or left as the
# development default below.
AUTH_TOKEN=change-me

# --- server ---
PORT=4000
NODE_ENV=development

# --- paths (relative to the repo root, or absolute) ---
DATABASE_PATH=./data/itmc.db
CONTENT_DIST=./content/dist
# Built web client. When this directory exists the API serves the UI at / as well as /api.
# Leave unset in development; Vite serves the UI on :5173 and proxies /api here.
# WEB_DIST=./apps/web/dist

# --- browser access ---
# Comma-separated list of allowed origins. In production, when the API serves the web client
# itself, leave this unset: same-origin requests need no CORS.
CORS_ORIGIN=http://localhost:5173
