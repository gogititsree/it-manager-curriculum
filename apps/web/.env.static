# Loaded by `vite build --mode static` (pnpm build:static). The server build never reads this file.
#
# VITE_BASE must match where the site is served from. GitHub Pages for a project repo serves from
# https://<user>.github.io/<repo>/, so this is the repo name. A fork with a different name can
# override it from the environment (VITE_BASE=/my-fork/ pnpm build:static) without editing this file;
# for a user/organisation site (<user>.github.io) set it to /.
VITE_APP_MODE=static
VITE_BASE=/it-manager-curriculum/
