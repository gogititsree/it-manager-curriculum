{
  "name": "it-manager-curriculum",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm content:build && pnpm --filter @itmc/api build && pnpm --filter @itmc/web build",
    "dev": "pnpm --parallel --filter @itmc/api --filter @itmc/web dev",
    "start": "node apps/api/dist/main.js",
    "content:build": "pnpm --filter @itmc/content-build run build-content",
    "content:validate": "pnpm --filter @itmc/content-build run validate",
    "content:new-topic": "pnpm --filter @itmc/content-build run new-topic",
    "db:generate": "pnpm --filter @itmc/db run generate",
    "db:migrate": "pnpm --filter @itmc/db run migrate",
    "token:new": "node scripts/new-token.mjs",
    "token:list": "node scripts/revoke-token.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm content:validate && pnpm test"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}
